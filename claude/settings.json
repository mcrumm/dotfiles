{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://192.168.50.91:4317",
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "cumulative",
    "OTEL_METRIC_EXPORT_INTERVAL": "10000",
    "OTEL_LOGS_EXPORT_INTERVAL": "5000"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/mcrumm/.dotfiles/claude/hooks/claude-plan-check.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/mcrumm/.dotfiles/claude/hooks/claude-turn-start.sh",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "/Users/mcrumm/.dotfiles/claude/hooks/claude-ask-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/mcrumm/.dotfiles/claude/hooks/claude-turn-stop.sh",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "/Users/mcrumm/.dotfiles/claude/hooks/claude-ask-stop.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/mcrumm/.dotfiles/claude/hooks/claude-notify.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "syntaxHighlightingDisabled": false,
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "thinking": {
    "type": "adaptive",
    "display": "summarized"
  }
}
